# Copy to config/local.env and override only what differs in your environment.
# config/local.env is git-ignored, so credentials placed here stay local.

# PGUSER=postgres
# PGPASSWORD=change-me            # or use ~/.pgpass instead

# Point every experiment at a single local server:
# PRIMARY_HOST=localhost
# PARTITION_HOST=localhost
# REPLICA_HOST=localhost
# POOL_DIRECT_HOST=localhost
# POOL_PROXY_HOST=localhost
