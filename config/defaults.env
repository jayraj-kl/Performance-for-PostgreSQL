# Reference environment used for the published results (AWS RDS, PostgreSQL 17.4, ap-south-1).
#
# Do not edit this file to point at your own database. Instead, copy
# config/local.env.example to config/local.env (git-ignored) and override
# the keys you need there, or export them in your shell.
#
# Precedence: shell environment > config/local.env > config/defaults.env

# Shared connection settings
PGPORT=5432
PGUSER=postgres

# Endpoints
PRIMARY_HOST=database-1.cxa0i80mysid.ap-south-1.rds.amazonaws.com
PARTITION_HOST=database-2.cxa0i80mysid.ap-south-1.rds.amazonaws.com
REPLICA_HOST=database-replica-1.cxa0i80mysid.ap-south-1.rds.amazonaws.com
POOL_DIRECT_HOST=database-connection-pool.cxa0i80mysid.ap-south-1.rds.amazonaws.com
POOL_PROXY_HOST=connection-pool-proxy.proxy-cxa0i80mysid.ap-south-1.rds.amazonaws.com

# Databases
BASECASE_DB=BaseCase
POOL_DB=ConnectionPool
PARTITION_DB=Partitioned
REPLICA_DB=ReadReplica
MONITOR_DB=postgres
